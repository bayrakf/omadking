# Copy to .env.local and fill in. Only EXPO_PUBLIC_* vars reach the client bundle,
# so never put a secret behind that prefix — it ships to every user.

# --- Client (safe to expose; the anon key is protected by row-level security) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- In-app purchases (public SDK keys, native builds only) ---
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Server only: set with `supabase secrets set`, NEVER in this file ---
# GEMINI_API_KEY=...
# SERVICE_ROLE_KEY=...
